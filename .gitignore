# dependencies and build output (rebuild with: npm run build)
node_modules/
dist/
music/playlist.js

# Blender autosave backups
*.blend1
*.blend2

# logs, editor and OS junk
*.log
*.tmp
.DS_Store
Thumbs.db
.claude/settings.local.json

# Local launcher build/install fingerprints (never source files)
.paradise-startup/

# User-added songs read directly from music/; existing tracked songs stay tracked.
/music/*.[mM][pP]3
/music/*.[oO][gG][gG]
/music/*.[wW][aA][vV]
/music/*.[mM]4[aA]
/music/*.[fF][lL][aA][cC]
/music/*.[oO][pP][uU][sS]

# Timestamped snapshots generated by the notebook server (not the live notebook).
/notes/backups/island-notes.r[0-9]*.????-??-??T??-??-??-???Z.json
